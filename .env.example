# Copy handled by scripts/gen-secrets.sh; do not put real secrets in this file.
# Contact email for Let's Encrypt certificates:
ACME_EMAIL=admin@gocosmos.org
POSTGRES_SYNAPSE_PASSWORD=__GENERATED__
POSTGRES_BRIDGE_PASSWORD=__GENERATED__
# Uncomment once DNS points at the VPS to enable the public entrypoint (Caddy):
# COMPOSE_PROFILES=public

# Discord -> Matrix onboarding daemon (see onboarding/onboard.py).
# Leave empty to keep the daemon idle.
DISCORD_BOT_TOKEN=
ONBOARD_ADMIN_TOKEN=
BRIDGE_AS_TOKEN=
GUILD_ID=
# Comma-separated channelid:messageid pairs whose white-check-mark reactions
# trigger account creation:
ONBOARD_WATCH=

# Public registration page at chat.gocosmos.org/join (see join/join.py).
# Must equal registration_shared_secret in synapse/homeserver.yaml;
# leave empty to keep the page idle.
REGISTRATION_SHARED_SECRET=__GENERATED__
