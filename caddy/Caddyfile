{
	email {$ACME_EMAIL}
}

matrix.gocosmos.org {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Admin API is never exposed publicly; use an SSH tunnel instead
	@admin path /_synapse/admin/*
	respond @admin 403

	reverse_proxy /_matrix/* synapse:8008
	reverse_proxy /_synapse/client/* synapse:8008

	# Avatar proxy for Discord relay webhooks (bridge public_address)
	reverse_proxy /mautrix-discord/* bridge:29334
}

chat.gocosmos.org {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Serve the Cosmos icon instead of Element's branding; matching every
	# icon path keeps this working across Element upgrades (hashed filenames)
	handle /vector-icons/* {
		root * /srv/cosmos-icons
		rewrite * /icon.png
		file_server
	}
	handle /favicon.ico {
		root * /srv/cosmos-icons
		rewrite * /icon.png
		file_server
	}
	handle {
		reverse_proxy element:80
	}
}
